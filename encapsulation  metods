        "# CREATE a class libary book that demonstrates encapsulation.\n",
        "\n",
        "class Library:\n",
        "    def __init__(self, initial_book_count):\n",
        "        # Private attribute using name mangling for encapsulation\n",
        "        self.__total_books = initial_book_count\n",
        "        # Private attribute for the count of available books\n",
        "        self.__available_books_count = initial_book_count\n",
        "\n",
        "    # Public method to display information, accessing private attributes\n",
        "    def display_library_status(self):\n",
        "        print(f'Total books in library: {self.__total_books}')\n",
        "        print(f'Currently available books: {self.__available_books_count}')\n",
        "\n",
        "    # Public method to get the number of available books (getter)\n",
        "    def get_available_books_count(self):\n",
        "        return self.__available_books_count\n",
        "\n",
        "    # Public method to simulate borrowing a book (modifies private attribute)\n",
        "    def borrow_book(self):\n",
        "        if self.__available_books_count > 0:\n",
        "            self.__available_books_count -= 1\n",
        "            print(\"A book has been borrowed.\")\n",
        "        else:\n",
        "            print(\"No books currently available to borrow.\")\n",
        "\n",
        "    # Public method to simulate returning a book (modifies private attribute)\n",
        "    def return_book(self):\n",
        "        if self.__available_books_count < self.__total_books:\n",
        "            self.__available_books_count += 1\n",
        "            print(\"A book has been returned.\")\n",
        "        else:\n",
        "            print(\"Cannot return more books than the library has.\")\n",
        "\n",
        "my_library = Library(initial_book_count=20) # Initialize with 20 books\n",
        "\n",
        "print(\"--- Initial Status ---\")\n",
        "my_library.display_library_status()\n",
        "\n",
        "print(\"\\n--- Borrowing books ---\")\n",
        "my_library.borrow_book()\n",
        "my_library.borrow_book()\n",
        "my_library.display_library_status()\n",
        "\n",
        "print(\"\\n--- Checking available count ---\")\n",
        "print(f\"Available books via getter: {my_library.get_available_books_count()}\")\n",
        "\n"
      ],
