        "# ACCOUNT management system\n",
        "# name, balance -> private\n",
        "class Account:\n",
        "    def __init__(self, name, balance):\n",
        "        self.__name = name  # Private attribute for account holder's name\n",
        "        self.__balance = balance  # Private attribute for account balance\n",
        "\n",
        "    # Public method to display account details (getter-like functionality)\n",
        "    def display(self):\n",
        "        print(f'Account Holder: {self.__name}')\n",
        "        print(f'Current Balance: ${self.__balance:.2f}')\n",
        "\n",
        "    # Public method to deposit money (modifies private attribute)\n",
        "    def deposit(self, amount):\n",
        "        if amount > 0:\n",
        "            self.__balance += amount\n",
        "            print(f'Deposited ${amount:.2f}. New balance: ${self.__balance:.2f}')\n",
        "        else:\n",
        "            print('Deposit amount must be positive.')\n",
        "\n",
        "    # Public method to withdraw money (modifies private attribute)\n",
        "    def withdraw(self, amount):\n",
        "        if amount > 0:\n",
        "            if self.__balance >= amount:\n",
        "                self.__balance -= amount\n",
        "                print(f'Withdrew ${amount:.2f}. New balance: ${self.__balance:.2f}')\n",
        "            else:\n",
        "                print('Insufficient funds.')\n",
        "        else:\n",
        "            print('Withdrawal amount must be positive.')\n",
        "\n",
        "    # Public method to get the current balance (getter)\n",
        "    def get_balance(self):\n",
        "        return self.__balance\n",
        "\n",
        "\n",
        "print(\"--- Creating Account ---\")\n",
        "my_account = Account(\"Alice Smith\", 1000.00)\n",
        "my_account.display()\n",
        "\n",
        "print(\"\\n--- Depositing Funds ---\")\n",
        "my_account.deposit(500.00)\n",
        "my_account.deposit(-50.00) # Invalid deposit\n",
        "my_account.display()\n"
